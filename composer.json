{
  "name": "thisisboris/psr-7",
  "license": "GPL-3.0-or-later",
  "type": "project",
  "authors": [
    {
      "name": "Boris Wintein",
      "email": "boris.wintein@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-ds": "*",
    "ext-http": "*",
    "azjezz/psl": "^3.2",
    "nikic/iter": "^2.4",
    "php-ds/php-ds": "^1.5",
    "psr/http-message": "^2.0"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.45",
    "phpunit/phpunit": "^11.2",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.69",
    "vimeo/psalm": "^6.6",
    "psalm/plugin-phpunit": "^0.19.2",
    "psalm/plugin-symfony": "^5.2"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Thisisboris\\Psr7\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Thisisboris\\Basil\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true
    }
  }
}
